# Google Places API (New) key. Get one in Google Cloud Console →
# APIs & Services → Credentials, with "Places API (New)" enabled.
# NEVER commit it or paste it into output files.
GOOGLE_PLACES_API_KEY=

# "true" (default) = use packages/core/fixtures/places-response.json, no API quota spent.
# "false" = call the real Google Places API.
MOCK_API=true

# Max parallel searches against the API.
CONCURRENCY=5

# OpenAI API key. Optional for --icp (if set, 2-3 search-phrase variants per
# category are generated with gpt-4o-mini and cached in cache/variants.json;
# without it, --icp uses only the original category).
# REQUIRED for `pnpm enrich` (contact extraction from each lead's website).
OPENAI_API_KEY=

# Max websites enriched in parallel by `pnpm enrich`.
ENRICH_CONCURRENCY=5

# Fields written to leadoutput/enriched-*.json, comma-separated. Empty = all
# fields (default). Entries where every listed field is null are dropped.
# Valid: name, website, phone, address, rating, reviewCount, sourceQuery,
# contactName, contactRole, contactEmail, confidence, instagram, whatsapp
# Example (emails only): ENRICH_OUTPUT_FIELDS=contactEmail
ENRICH_OUTPUT_FIELDS=
